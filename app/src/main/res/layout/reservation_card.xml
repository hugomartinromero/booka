<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="30dp"
    android:layout_marginTop="10dp"
    android:layout_marginBottom="8dp"
    android:backgroundTint="@color/booka_background"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="25dp"
    app:cardElevation="4dp"
    app:strokeColor="@color/booka_primary"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bgReviewCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/lblTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="-25dp"
            android:background="@color/booka_primary"
            android:fontFamily="@font/montserrat_bold"
            android:gravity="center_vertical"
            android:paddingVertical="10dp"
            android:paddingStart="45dp"
            android:paddingEnd="20dp"
            android:text="@string/textview"
            android:textColor="@color/booka_background"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="@+id/lblReservationBusiness"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/lblReservationBusiness"
            app:layout_constraintTop_toTopOf="@+id/lblReservationBusiness" />

        <TextView
            android:id="@+id/lblReservationBusiness"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_background_top_25"
            android:backgroundTint="@color/booka_background"
            android:fontFamily="@font/montserrat_bold"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:text="@string/textview"
            android:textColor="@color/booka_text_primary"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/lblReservationServiceName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_bold"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="20dp"
            android:text="@string/textview"
            android:textColor="@color/booka_text_secondary"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="@+id/lblReservationBusiness"
            app:layout_constraintStart_toStartOf="@+id/lblReservationBusiness"
            app:layout_constraintTop_toBottomOf="@+id/lblReservationBusiness" />

        <TextView
            android:id="@+id/lblPrice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_bold"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="20dp"
            android:text="@string/textview"
            android:textColor="@color/booka_text_primary"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="@+id/lblTime"
            app:layout_constraintStart_toEndOf="@+id/lblReservationBusiness"
            app:layout_constraintTop_toBottomOf="@+id/lblTime" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>