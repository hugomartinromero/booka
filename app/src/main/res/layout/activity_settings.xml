<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/booka_primary"
    tools:context=".view.activity.SettingsActivity">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="-25dp"
        android:background="@color/booka_background"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lblSettings">

        <include
            android:id="@+id/itemAccount"
            layout="@layout/item_setting_arrow" />

        <include
            android:id="@+id/itemLanguage"
            layout="@layout/item_setting_arrow" />

        <include
            android:id="@+id/itemPassword"
            layout="@layout/item_setting_arrow" />

        <include
            android:id="@+id/itemGoogle"
            layout="@layout/item_setting_arrow" />

        <include
            android:id="@+id/itemDarkMode"
            layout="@layout/item_setting_switch" />

        <TextView
            android:id="@+id/lblLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_bold"
            android:paddingVertical="8dp"
            android:text="@string/cerrar_sesi_n"
            android:textColor="@android:color/holo_red_dark"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/lblSettings"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="50dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="50dp"
        android:background="@drawable/rounded_background_all_25"
        android:backgroundTint="@color/booka_background"
        android:fontFamily="@font/montserrat_bold"
        android:gravity="center_vertical"
        android:paddingHorizontal="55dp"
        android:text="@string/configuraci_n"
        android:textAlignment="center"
        android:textColor="@color/booka_text_primary"
        android:textSize="20sp"
        app:flow_verticalAlign="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>